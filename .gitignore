# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
# Only ignore root-level dist/, not frontend/dist/
/dist/
build/
*.egg
.eggs/
venv/
.venv/
env/
*.so
.Python
develop-eggs/
downloads/
lib/
lib64/
parts/
sdist/
var/
wheels/
.installed.cfg

